{
  "extends": [
    "development"
  ],
  "hints": {
    "compat-api/html": [
      "default",
      {
        "ignore": [
          "meta[name=theme-color]",
          "img[fetchpriority]"
        ]
      }
    ],
    "compat-api/css": [
      "default",
      {
        "ignore": [
          "-webkit-text-size-adjust",
          "background-color: color-mix(in srgb, oklch(98.7% 0.022 95.277) 50%, transparent)",
          "background-color: color-mix(in srgb, oklch(92.4% 0.12 95.746) 30%, transparent)",
          "background-color: color-mix(in srgb, oklch(66.6% 0.179 58.318) 10%, transparent)",
          "background-color: color-mix(in srgb, oklch(66.6% 0.179 58.318) 20%, transparent)",
          "background-color: color-mix(in srgb, oklch(55.5% 0.163 48.998) 30%, transparent)",
          "scrollbar-width",
          "scrollbar-width: none"
        ]
      }
    ],
    "manifest-exists": "off",
    "apple-touch-icons": "off"
  }
}