{
  "name": "beloved-berachah-cic",
  "version": "1.0.0",
  "description": "Official website and PWA for Beloved Berachah CIC",
  "private": true,
  "scripts": {
    "build:css": "npx @tailwindcss/cli -i ./src/input.css -o ./css/style.css --minify",
    "watch:css": "npx @tailwindcss/cli -i ./src/input.css -o ./css/style.css --watch",
    "build": "npm run build:css && npx @11ty/eleventy",
    "start": "concurrently \"npm run watch:css\" \"npx @11ty/eleventy --serve\""
  },
  "devDependencies": {
    "@11ty/eleventy": "^3.1.6",
    "@tailwindcss/cli": "^4.3.3",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.3.3"
  },
  "dependencies": {
    "puppeteer": "^25.10.0"
  }
}