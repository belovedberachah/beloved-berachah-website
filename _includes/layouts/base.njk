<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <!-- ========================================= -->
    <!-- FIRST-CLASS SEO OPTIMIZATION              -->
    <!-- ========================================= -->
    <!-- Core Search Engine Tags -->
    <title>{{ title }}</title>
    <meta name="description" content="{{ description }}" />
    <meta name="author" content="Beloved Berachah CIC" />
    <link rel="canonical" href="https://belovedberachah.netlify.app{{ page.url }}" />

    <!-- Open Graph / Social Media Preview Cards -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content="https://belovedberachah.netlify.app{{ page.url }}" />
    <meta property="og:title" content="{{ title }}" />
    <meta property="og:description" content="{{ description }}" />
    <meta property="og:image" content="https://belovedberachah.netlify.app/assets/images/BB.png" />
    <meta property="og:site_name" content="Beloved Berachah CIC" />

    <!-- Twitter / X Preview Cards -->
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="{{ title }}" />
    <meta name="twitter:description" content="{{ description }}" />
    <meta name="twitter:image" content="https://belovedberachah.netlify.app/assets/images/BB.png" />

    <!-- Google Search Console Verification -->
    <meta name="google-site-verification" content="YOUR_GOOGLE_VERIFICATION_CODE" />

    <!-- Schema.org Structured Data -->
    <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "NGO",
      "name": "Beloved Berachah CIC",
      "url": "https://belovedberachah.netlify.app/",
      "logo": "https://belovedberachah.netlify.app/assets/images/BB.png",
      "description": "Supporting women affected by trauma, addiction, domestic abuse, and mental health challenges.",
      "founder": {
        "@type": "Person",
        "name": "Brenda Fraser"
      }
    }
    </script>

    <!-- Global Assets (Fonts, Tailwind, Styling) -->
    {% include "components/head-global.html" %}
    {% block customhead %}{% endblock %}
  </head>

  <body class="flex flex-col min-h-screen bg-[#7B539B] text-slate-100 font-sans selection:bg-amber-500 selection:text-black" style="background-image: url('data:image/svg+xml,%3Csvg viewBox=%220 0 200 200%22 xmlns=%22http://www.w3.org/2000/svg%22%3E%3Cfilter id=%22noiseFilter%22%3E%3CfeTurbulence type=%22fractalNoise%22 baseFrequency=%220.8%22 numOctaves=%223%22 stitchTiles=%22stitch%22/%3E%3C/filter%3E%3Crect width=%22100%25%22 height=%22100%25%22 filter=%22url(%23noiseFilter)%22 opacity=%220.06%22/%3E%3C/svg%3E'); background-attachment: fixed;">

    <!-- Splash Screen & PWA -->
    {% include "components/splash-and-pwa.html" %}

    <!-- Navigation -->
    {% include "components/navigation.html" %}

    <!-- ========================================= -->
    <!-- MAIN CONTENT INJECTED HERE                -->
    <!-- ========================================= -->
    <main role="main" class="grow">
      {{ content | safe }}
    </main>

    <!-- Footer -->
    {% include "components/footer.html" %}

    <!-- Cookies -->
    {% include "components/cookies.html" %}
    {% block customScripts %}{% endblock %}

  </body>
</html>